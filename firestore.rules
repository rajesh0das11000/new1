rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---
    function isValidProfile(data) {
      return data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 50 &&
             data.gender in ['male', 'female', 'non-binary', 'other'] &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    function isValidLike(data) {
      return data.fromId == request.auth.uid &&
             data.toId is string && data.toId != request.auth.uid &&
             data.createdAt == request.time;
    }

    function isValidMatch(data) {
      return data.userIds.size() == 2 &&
             request.auth.uid in data.userIds &&
             data.status in ['pending', 'matched', 'blocked'] &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    function isValidMessage(data, matchId) {
      return data.senderId == request.auth.uid &&
             data.text is string && data.text.size() <= 1000 &&
             data.createdAt == request.time &&
             get(/databases/$(database)/documents/matches/$(matchId)).data.userIds.hasAny([request.auth.uid]);
    }

    // --- Match Rules ---

    // Profiles
    match /profiles/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // Allow browsing profiles
      allow create: if isOwner(userId) && isValidProfile(incoming());
      allow update: if isOwner(userId) && 
                    incoming().uid == existing().uid &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().updatedAt == request.time;
    }

    // Likes
    match /likes/{likeId} {
      allow read: if isSignedIn() && (existing().fromId == request.auth.uid || existing().toId == request.auth.uid);
      allow create: if isSignedIn() && isValidLike(incoming());
      allow delete: if isSignedIn() && existing().fromId == request.auth.uid;
    }

    // Matches
    match /matches/{matchId} {
      allow get: if isSignedIn() && request.auth.uid in existing().userIds;
      allow list: if isSignedIn() && resource.data.userIds.hasAny([request.auth.uid]);
      allow create: if isSignedIn() && isValidMatch(incoming());
      allow update: if isSignedIn() && request.auth.uid in existing().userIds &&
                    incoming().userIds == existing().userIds &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().updatedAt == request.time;

      // Messages (Subcollection)
      match /messages/{messageId} {
        allow list: if isSignedIn() && get(/databases/$(database)/documents/matches/$(matchId)).data.userIds.hasAny([request.auth.uid]);
        allow create: if isSignedIn() && isValidMessage(incoming(), matchId);
      }
    }
  }
}
